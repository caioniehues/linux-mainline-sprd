			mmc@1100000 {
				compatible = "sprd,sdhci-r11";
				reg = <0x1100000 0x1000>;
				interrupts = <0x00 0x13 0x04>;
				clocks = <0x4a 0x13 0x6b 0x16>;
				clock-names = "sdio", "enable";
				assigned-clocks = <0x4a 0x13>;
				assigned-clock-parents = <0x72 0x00>;
				status = "okay";
				bus-width = <0x04>;
				/* Stock Samsung X200XXS6DYG6 & upstream ums512-1h10 UHS-I PHY delays */
				sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x73 0x72 0x72>;
				sprd,phy-delay-sd-uhs-sdr50 = <0x6e 0x7f 0x01 0x01>;
				sprd,phy-delay-sd-highspeed = <0x7f 0x1a 0x9a 0x9a>;
				sprd,phy-delay-legacy = <0x7f 0x1a 0x9a 0x9a>;
				sd-uhs-sdr104;
				sd-uhs-sdr50;
				no-sdio;
				no-mmc;
				cd-gpios = <0x73 0x13 0x00>;
