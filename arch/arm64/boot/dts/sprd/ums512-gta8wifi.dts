		apb@70000000 {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x70000000 0x10000000>;

			serial@0 {
				compatible = "sprd,ums512-uart", "sprd,sc9836-uart";
				reg = <0x00 0x100>;
				interrupts = <0x00 0x02 0x04>;
				clocks = <0x4a 0x0b 0x1a 0x6b 0x0e>;
				status = "okay";
				clock-names = "uart", "source", "enable";
			};

			serial@100000 {
				compatible = "sprd,ums512-uart", "sprd,sc9836-uart";
				reg = <0x100000 0x100>;
				interrupts = <0x00 0x03 0x04>;
				clocks = <0x4a 0x0c 0x1a 0x6b 0x0f>;
