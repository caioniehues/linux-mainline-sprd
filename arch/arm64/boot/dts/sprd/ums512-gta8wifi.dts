			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x60100000 0x3000>;
			phandle = <0xc9>;

			clock-controller@0 {
				compatible = "sprd,ums512-gpu-clk";
				clocks = <0x1a>;
				clock-names = "ext-26m";
				reg = <0x00 0x100>;
				power-domains = <0x43 0x0a>;
				#clock-cells = <0x01>;
				#reset-cells = <0x01>;
				phandle = <0x44>;
			};
		};

		syscon@60110000 {
			compatible = "sprd,ums512-glbregs", "syscon", "simple-mfd";
			reg = <0x00 0x60110000 0x00 0x3000>;
		};

		gpu@60000000 {
			compatible = "sprd,ums512-mali", "arm,mali-bifrost";
			reg = <0x00 0x60000000 0x00 0x100000>;
			interrupts = <0x00 0x3c 0x04 0x00 0x3c 0x04 0x00 0x3c 0x04>;
			interrupt-names = "job", "mmu", "gpu";
			clocks = <0x44 0x01 0x44 0x00 0x44 0x02 0x44 0x04 0x44 0x03>;
			clock-names = "core", "gpu", "mem", "bus", "mem_clk";
			assigned-clocks = <0x45 0x1d>;
			assigned-clock-rates = <0x32a9f880>;
			/* Stock mali_gondul.ko /qos/qos@0: gpu_qos_sel=1 (bit 16) + arqos=6/awqos=6/thresh=f/f -> 0x1ff66 */
			sprd,gpu-qos-syscon = <0xc9 0x10 0x0001ff66>;
			power-domains = <0x43 0x0a>;
			resets = <0x44 0x00>;
			operating-points-v2 = <0x46>;
			#cooling-cells = <0x02>;
			status = "okay";
			mali-supply = <0x47>;
			phandle = <0xa6>;
		};

		opp-table-gpu {
			compatible = "operating-points-v2";
			phandle = <0x46>;

			opp-384000000 {
				opp-hz = <0x00 0x16e36000>;
				opp-microvolt = <0xaae60>;
			};

			opp-512000000 {
				opp-hz = <0x00 0x1e848000>;
				opp-microvolt = <0xb71b0>;
			};

			opp-614400000 {
				opp-hz = <0x00 0x249f0000>;
				opp-microvolt = <0xb71b0>;
