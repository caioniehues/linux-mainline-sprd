	clk-26m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x18cba80>;
		clock-output-names = "ext-26m";
		phandle = <0x1a>;
	};

	dphy-273m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x1045a640>;
		clock-output-names = "dphy-273m";
		phandle = <0xaf>;
	};

	dphy-204m8 {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = "\f5", "";
		clock-output-names = "dphy-204m8";
	};

	clk-32k {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x8000>;
		clock-output-names = "ext-32k";
		phandle = <0x4b>;
	};

	clk-4m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = "", "=\t";
		clock-output-names = "ext-4m";
		phandle = <0x4c>;
	};

	clk-100m {
		compatible = "fixed-clock";
		#clock-cells = <0x00>;
		clock-frequency = <0x5f5e100>;
		clock-output-names = "rco-100m";
		phandle = <0x4d>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0xfffff000>;
	};

	chosen {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		stdout-path = "serial1:115200n8";
	};

	regulator-lcd-avdd {
		compatible = "regulator-fixed";
		regulator-name = "lcd-avdd";
		gpio = <0x6c 0x8b 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x77>;
	};

	regulator-lcd-avee {
		compatible = "regulator-fixed";
		regulator-name = "lcd-avee";
		gpio = <0x6c 0x8a 0x00>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
		phandle = <0x78>;
	};

	gpio-keys {
		compatible = "gpio-keys";

		key-power {
			label = "Power Key";
			linux,code = <0x74>;
			gpios = <0x7c 0x01 0x01>;
			debounce-interval = <0x02>;
			wakeup-source;
		};

		key-volumedown {
			label = "Volume Down Key";
			linux,code = <0x72>;
			gpios = <0x7c 0x04 0x00>;
			debounce-interval = <0x02>;
		};

		key-volumeup {
			label = "Volume Up Key";
			linux,code = <0x73>;
			gpios = <0x6c 0x7d 0x01>;
			debounce-interval = <0x02>;
		};

		sw-cover {
			label = "Book Cover";
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			gpios = <0x6c 0x54 0x01>;
			debounce-interval = <0x0a>;
		};
	};

	sprd-marlin3 {
		compatible = "unisoc,marlin3lite_sdio";
		enable-gpios = <0x6c 0x8f 0x01>;
		reset-gpios = <0x6c 0x5f 0x01>;
		m2-wakeup-ap-gpios = <0x6c 0x20 0x01>;
