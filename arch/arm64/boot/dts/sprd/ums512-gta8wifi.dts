					compatible = "awinic,aw88266a";
					reg = <0x34>;
					#sound-dai-cells = <0x00>;
					sound-name-prefix = "LU";
					reset-gpios = <0x6c 0x33 0x01>;
					awinic,dev-index = <0x00>;
					sound-channel = <0x00>;
					spin-data = "l l r r";
					phandle = <0xc0>;
