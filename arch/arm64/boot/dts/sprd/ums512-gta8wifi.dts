						"I dcs=c8 data=000404000082",
						"I dcs=bd data=00",
						"I dcs=cb data=0013080225",
						"I dcs=bd data=02",
						"I dcs=cb data=000300017e",
						"I dcs=bd data=00",
						"I dcs=c7 data=3080c208104204",
						"I dcs=e1 data=0005",
						"I dcs=bd data=00",
						"I dcs=cc data=0e",
						"I dcs=51 data=0000",
						"I dcs=c9 data=000e10",
						"I dcs=53 data=2c",
						"I seq=11 wait=32",
						"I seq=29 wait=14",
						"I dcs=b9 data=000000";

					port {

						endpoint {
							remote-endpoint = <0xb3>;
							phandle = <0xb2>;
						};
					};
