/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Samsung Galaxy Tab A8 10.5 (SM-X200)";
	compatible = "samsung,gta8wifi", "sprd,ums512-25c10", "sprd,ums512";
	sprd,sc-id = "ums512 wifionly 1000";

	aliases {
		mmc0 = "/soc/apb@70000000/mmc@1100000";
		mmc1 = "/soc/apb@70000000/mmc@1200000";
		mmc3 = "/soc/apb@70000000/mmc@1400000";
		i2c0 = "/soc/apb@70000000/i2c@300000";
		i2c1 = "/soc/apb@70000000/i2c@400000";
		i2c2 = "/soc/apb@70000000/i2c@500000";
		i2c3 = "/soc/apb@70000000/i2c@600000";
		i2c4 = "/soc/apb@70000000/i2c@700000";
		i2c7 = "/soc/bus@32000000/i2c@60000";
		serial0 = "/soc/apb@70000000/serial@0";
		serial1 = "/soc/apb@70000000/serial@100000";
		spi2 = "/soc/apb@70000000/spi@a00000";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		audio-mem@87400000 {
			reg = <0x00 0x87400000 0x00 0x400000>;
			no-map;
			phandle = <0x13>;
		};

		smem@88000000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0x88000000 0x00 0x40000>;
			no-map;
			phandle = <0x19>;
		};

		pmsys@88040000 {
			reg = <0x00 0x88040000 0x00 0x2c0000>;
			no-map;
			phandle = <0x18>;
		};

		audiodsp-mem@89000000 {
			reg = <0x00 0x89000000 0x00 0x600000>;
			no-map;
			phandle = <0x12>;
		};

		ddrbist-mem@80000000 {
			reg = <0x00 0x80000000 0x00 0x1000>;
			no-map;
		};

		sysdumpinfo-mem@80001000 {
			reg = <0x00 0x80001000 0x00 0x1000>;
			no-map;
		};

		rebootescrow@81ff0000 {
			reg = <0x00 0x81ff0000 0x00 0x10000>;
			no-map;
		};

		/*
		 * Deduplicated audio-mem@87500000 (subset of audio-mem@87400000)
		 * and sp-ddr-mem@88000000 (union of smem@88000000 + pmsys@88040000).
		 * Reclaimed 196.47 MiB of unused Android carveouts:
		 *   cp-modem@89600000 (85 MiB), hole-mem@8f000000 (11 MiB),
		 *   faceid-mem@efaae000 (5 MiB), vdsp-mem@f09ae000 (55 MiB),
		 *   framebuffer-mem@fd708000 (30.35 MiB), writeback-mem@ff562000 (10.12 MiB).
		 * Validate zero bad pages with tools/ram-scan.py after booting!
		 */

		sipc-mem@87800000 {
			reg = <0x00 0x87800000 0x00 0x800000>;
			no-map;
		};

		sipc-ss-mem@88300000 {
			reg = <0x00 0x88300000 0x00 0x80000>;
			no-map;
		};

		sml-mem@94000000 {
			reg = <0x00 0x94000000 0x00 0x40000>;
			no-map;
		};

		tos-mem@94040000 {
			reg = <0x00 0x94040000 0x00 0x5fc0000>;
			no-map;
		};

		sh-mem@9a000000 {
			reg = <0x00 0x9a000000 0x00 0x100000>;
			no-map;
		};

		ramoops@fff80000 {
			compatible = "ramoops";
			reg = <0x00 0xfff80000 0x00 0x40000>;
			record-size = <0x8000>;
			console-size = <0x8000>;
			pmsg-size = <0x8000>;
			no-map;
		};

		debug-mem@100000000 {
			reg = <0x01 0x00 0x00 0x1000>;
			no-map;
		};

		framebuffer-region@9e000000 {
			compatible = "framebuffer";
			reg = <0x00 0x9e000000 0x00 0x8ca000>;
			iommu-addresses = <0x02 0x9e000000 0x8ca000>;
			no-map;
			phandle = <0xad>;
		};

		/*
		 * Stock wifionly overlay: drm_reserved (secure video). The TEE
		 * firewalls it: writes vanish, reads return zero (measured
		 * 2026-11-10, 0xe32ae000-0xee6adfff). Reserve stock's full size.
		 */
		drm-mem@e32ae000 {
			reg = <0x00 0xe32ae000 0x00 0xc800000>;
			no-map;
		};

		protected-mem@effae000 {
			reg = <0x00 0xeffae000 0x00 0x2000>;
			no-map;
		};
	};

	opp-table0 {
		sprd,hw-dvfs-device = <0x03>;
		cpufreq-cluster-cpumask = <0x3f>;
		transition_delay_us = <0x1f4>;
		operating-points = <0x96000 0xb8a1a 0xbb800 0xb8a1a 0xeadd0 0xb8a1a 0x1174c0 0xb8a1a 0x12c000 0xc042c 0x169d10 0xd59f8 0x177000 0xd9701 0x1a2f20 0xe8b25 0x1bc560 0xf1da1 0x1e8c50 0x100590>;
		phandle = <0x0c>;
	};

	opp-table1 {
		sprd,hw-dvfs-device = <0x03>;
		cpufreq-cluster-cpumask = <0xc0>;
		transition_delay_us = <0x1f4>;
		operating-points = <0x12c000 0xb71b0 0x169d10 0xcf850 0x177000 0xd4670 0x1a94b0 0xe7ef0 0x1c9080 0xf4240 0x1e8c50 0x100590>;
		phandle = <0x0e>;
	};

	dvfs-dcdc-cpu0-cfg {
		pmic-type-num = <0x00>;
		slew-rate = <0x249f>;
		tuning-latency-us = <0x00>;
		phandle = <0x22>;
	};

	dvfs-dcdc-cpu1-cfg {
		third-pmic-used;
		chnl-i2c-used;
		pmic-type-num = <0x02>;
		slew-rate = <0xfa0>;
		tuning-latency-us = <0x00>;
		phandle = <0x23>;
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x04>;
				};

				core1 {
					cpu = <0x05>;
				};

				core2 {
					cpu = <0x06>;
				};

				core3 {
					cpu = <0x07>;
				};

				core4 {
					cpu = <0x08>;
				};

				core5 {
					cpu = <0x09>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x0a>;
				};

				core1 {
					cpu = <0x0b>;
				};
			};
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x00>;
			cpufreq-data-v1 = <0x0c>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			#cooling-cells = <0x02>;
			phandle = <0x04>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x100>;
			cpufreq-data-v1 = <0x0c>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			#cooling-cells = <0x02>;
			phandle = <0x05>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x200>;
			cpufreq-data-v1 = <0x0c>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			#cooling-cells = <0x02>;
			phandle = <0x06>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x300>;
			cpufreq-data-v1 = <0x0c>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			#cooling-cells = <0x02>;
			phandle = <0x07>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x400>;
			cpufreq-data-v1 = <0x0c>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			#cooling-cells = <0x02>;
			phandle = <0x08>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00 0x500>;
			cpufreq-data-v1 = <0x0c>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x220>;
			dynamic-power-coefficient = <0x66>;
			#cooling-cells = <0x02>;
			phandle = <0x09>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x00 0x600>;
			cpufreq-data-v1 = <0x0e>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x1f5>;
			#cooling-cells = <0x02>;
			phandle = <0x0a>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};

		cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-a75";
			reg = <0x00 0x700>;
			cpufreq-data-v1 = <0x0e>;
			enable-method = "psci";
			cpu-idle-states = <0x0d>;
			clock-frequency = <0x6c7aff00>;
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x1f5>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;

			thermal-idle {
				#cooling-cells = <0x02>;
				duration-us = <0x2710>;
				exit-latency-us = <0xfa0>;
			};
		};
	};

	idle-states {
		entry-method = "psci";

		cpu-pd {
			compatible = "arm,idle-state";
			entry-latency-us = <0xfa0>;
			exit-latency-us = <0xfa0>;
			min-residency-us = <0x2710>;
			local-timer-stop;
			arm,psci-suspend-param = <0x10000>;
			phandle = <0x0d>;
		};
	};

	psci {
		compatible = "arm,psci-0.2";
		method = "smc";
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x0d 0x04 0x01 0x0e 0x04 0x01 0x0b 0x04 0x01 0x0a 0x04>;
	};

	pmu-a55 {
		compatible = "arm,cortex-a55-pmu";
		interrupts = <0x00 0x70 0x04 0x00 0x71 0x04 0x00 0x72 0x04 0x00 0x73 0x04 0x00 0x74 0x04 0x00 0x75 0x04>;
		interrupt-affinity = <0x04 0x05 0x06 0x07 0x08 0x09>;
	};

	pmu-a75 {
		compatible = "arm,cortex-a75-pmu";
		interrupts = <0x00 0x76 0x04 0x00 0x77 0x04>;
		interrupt-affinity = <0x0a 0x0b>;
	};

	display-subsystem {
		compatible = "sprd,display-subsystem";
		ports = <0x0f>;
		status = "okay";
	};

	audcp-boot {
		compatible = "sprd,ums512-audcp-boot";
		dsp-reboot-mode = <0x00>;
		sysshutdown = <0x10 0x60 0x2000000>;
		coreshutdown = <0x10 0x5c 0x1000000>;
		deepsleep = <0x10 0xcc 0x80000>;
		corereset = <0x10 0xb0 0x400>;
		sysreset = <0x10 0xb0 0x200>;
		reset_sel = <0x10 0x7a4 0xff>;
		sysstatus = <0x10 0xb8 0xff000000>;
		corestatus = <0x10 0x10c 0xff>;
		sleepstatus = <0x10 0xd4 0xf000>;
		bootprotect = <0x11 0x78 0xffff>;
		bootvector = <0x11 0x140 0xffffffff>;
		bootaddress_sel = <0x11 0x144 0x01>;
		accessenable = <0x11 0x14c 0x20>;
		memory-region = <0x12 0x13>;
		sprd,audcp-aon-iram = <0x14>;
		#power-domain-cells = <0x00>;
		status = "okay";
		phandle = <0x36>;
	};

	audcp-iram@a400 {
		reg = <0x00 0xa400 0x00 0x1000>;
		phandle = <0x14>;
	};

	sprd-pcm-audio {
		compatible = "unisoc,sharkl5-pcm-platform", "unisoc,sharkl5pro-pcm-platform";
		#sound-dai-cells = <0x00>;
		dmas = <0x15 0x01 0x15 0x02 0x15 0x03 0x15 0x04 0x15 0x11 0x15 0x12 0x15 0x0f 0x15 0x10 0x15 0x0e 0x15 0x08 0x15 0x0c 0x15 0x09 0x15 0x0d 0x15 0x08 0x15 0x0b 0x15 0x06 0x15 0x0e 0x15 0x0e 0x15 0x0c 0x15 0x06 0x15 0x07 0x15 0x14>;
		dma-names = "normal_p_l", "normal_p_r", "normal_c_l", "normal_c_r", "normal23_p_l", "normal23_p_r", "normal23_c_l", "normal23_c_r", "dspcap_c", "a2dppcm_p", "voice_c", "fast_p", "loop_c", "loop_p", "voip_c", "voip_p", "dspfmcap_c", "dspbtscocap_c", "recognise_c", "voice_pcm_p", "hifi_p", "hifi_fast_p";
		phandle = <0xbb>;
	};

	sprd-fe-dai {
		compatible = "unisoc,fe-dai";
		#sound-dai-cells = <0x01>;
		phandle = <0xbc>;
	};

	sprd-routing-pcm {
		compatible = "unisoc,pcm-routing";
		#sound-dai-cells = <0x00>;
		phandle = <0xbd>;
	};

	audio-sipc {
		compatible = "unisoc,audio_sipc";
		mboxes = <0x16 0x05>;
	};

	audio-mem-mgr {
		compatible = "unisoc,audio-mem-sharkl5", "unisoc,audio-mem-sharkl5pro";
		memory-region = <0x13 0x12>;
		ddr32-ap-dsp-map-offset = <0x00>;
		sprd,ddr32-dma = <0x87400000 0x300000>;
		sprd,ddr32-dspmemdump = <0x87700000 0x80000>;
		sprd,cmdaddr = <0x87780000 0x400>;
		sprd,smsg-addr = <0x87780400 0xa10>;
		sprd,shmaddr-aud-str = <0x87780e10 0x400>;
		sprd,shmaddr-dsp-vbc = <0x87781210 0x1400>;
		sprd,shmaddr-nxp = <0x87782610 0x400>;
		sprd,shmaddr-dsp-smartpa = <0x87782a10 0x1000>;
		sprd,shmaddr-reg-dump = <0x87783a10 0x400>;
		sprd,iram-ap-base = <0x33800000>;
		sprd,iram-dsp-base = <0x1800000>;
		sprd,offload-addr = <0x33800000 0x5c00>;
		sprd,normal-captue-linklilst-node1 = <0x33805e00 0x200>;
		sprd,normal-captue-data = <0x33806000 0x1e00>;
		sprd,normal-captue-linklilst-node2 = <0x33807e00 0x200>;
		sprd,audcp-aon-iram = <0x14>;
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		pmsys@800000 {
			compatible = "sprd,ums512-pmsys";
			/*
			 * LK 0x9f00c880 contract: sprd,name="pmic" + child cproc,name="pm_sys".
			 * Keep disabled until Trusty TA com.android.trusty.kernelbootcp
			 * (/dev/trusty-ipc-dev0) is wired: TrustOS locks AON_APB 0x327d008c
			 * (SP CM4 core reset) against non-secure EL1 writes.
			 */
			sprd,name = "pmic";
			status = "disabled";
			reg = <0x00 0x800000 0x00 0x1000>;
			dma-ranges = <0x18000000 0x00 0x88000000 0x8000000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x88040000 0x00 0x88040000 0x200000>;
			sprd,syscon-aon-apb = <0x11>;
			sprd,syscon-pmu-apb = <0x10>;
			resets = <0x17 0x08>;
			memory-region = <0x18>;
			firmware-name = "sprd/pm_bootcode.bin", "sprd/pm_sys.bin";

			pm-sys@88040000 {
				cproc,name = "pm_sys";
				reg = <0x88040000 0x200000>;
			};

			sipc {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				label = "pmsys";
				mboxes = <0x16 0x01 0x16 0x06>;
				memory-region = <0x19>;

				channel@4 {
					reg = <0x04>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "pm_shub";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					sprd,num-buffers = <0x02>;
					sprd,tx-buf-size = <0x800>;
					sprd,rx-buf-size = <0xb00>;

					rpmsg@0 {
						compatible = "samsung,sprd-shub";
						reg = <0x00 0x00>;
						sprd,channel-name = "shub_main";
					};

					rpmsg@1 {
						compatible = "samsung,sprd-shub";
						reg = <0x01 0x01>;
						sprd,channel-name = "shub_nowakeup";
					};
				};

				channel@5 {
					reg = <0x05>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "slog_pm";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					sprd,tx-buf-size = <0x00>;
					sprd,rx-buf-size = <0x500>;

					rpmsg@0 {
						reg = <0x00 0x00>;
						sprd,channel-name = "slog_pm";
					};
				};

				channel@6 {
					reg = <0x06>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "sctl_pm";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					sprd,tx-buf-size = <0x20>;
					sprd,rx-buf-size = <0x40>;

					rpmsg@0 {
						reg = <0x00 0x00>;
						sprd,channel-name = "sctl_pm";
					};
				};

				channel@29 {
					reg = <0x29>;
					sprd,channel-type = "sbuf";
					sprd,channel-name = "stime_pm";
					#address-cells = <0x01>;
					#size-cells = <0x01>;
					sprd,tx-buf-size = <0x80>;
					sprd,rx-buf-size = <0x40>;

					rpmsg@0 {
						reg = <0x00 0x00>;
						sprd,channel-name = "stime_pm";
					};
				};

				channel@16 {
					reg = <0x16>;
					sprd,channel-type = "dfs";
					sprd,channel-name = "pm_ctrl";
				};
			};
		};

		interrupt-controller@12000000 {
			compatible = "arm,gic-v3";
			reg = <0x00 0x12000000 0x00 0x20000 0x00 0x12040000 0x00 0x100000>;
			#interrupt-cells = <0x03>;
			#address-cells = <0x02>;
			#size-cells = <0x02>;
			ranges;
			redistributor-stride = <0x00 0x20000>;
			#redistributor-regions = <0x01>;
			interrupt-controller;
			interrupts = <0x01 0x09 0x04>;
			phandle = <0x01>;
		};

		syscon@20100000 {
			compatible = "sprd,ums512-glbregs", "syscon", "simple-mfd";
			reg = <0x00 0x20100000 0x00 0x4000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x20100000 0x4000>;
			phandle = <0xae>;

			clock-controller@0 {
				compatible = "sprd,ums512-apahb-gate";
				reg = <0x00 0x3000>;
				clocks = <0x1a>;
				clock-names = "ext-26m";
				#clock-cells = <0x01>;
				phandle = <0x48>;
			};
		};

		syscon@31050000 {
