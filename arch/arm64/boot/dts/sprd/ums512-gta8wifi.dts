		/*
		 * AP DVFS block: selects the DPU core clock (work index at 0x124, see
		 * the dpu node). Stock: apsys-dvfs@71700000, "sprd,hwdvfs-apsys-sharkl5pro".
		 */
		syscon@71700000 {
			compatible = "syscon";
