				charger@3b {
					compatible = "sgmicro,sgm41542";
					reg = <0x3b>;
					interrupt-parent = <0x6c>;
					interrupts = <0x9c 0x08>;
					irq-gpios = <0x6c 0x9c 0x01>;
					pinctrl-names = "default";
