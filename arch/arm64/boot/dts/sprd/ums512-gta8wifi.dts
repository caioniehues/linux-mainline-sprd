		mm {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x20300000 0x00 0x20300000 0x200000>;

			dpu@20300000 {
				compatible = "sprd,ums512-dpu", "sprd,sharkl3-dpu";
				reg = <0x20300000 0x800>;
				interrupts = <0x00 0x1b 0x04>;
				clocks = <0x48 0x01 0x4a 0x17 0x4a 0x18>;
				clock-names = "core", "clk", "dpi";
				iommus = <0xac>;
				status = "okay";
				memory-region = <0xad>;
				reset-syscon = <0xae 0x04 0x02>;
				sprd,dpi-clk-div = <0x06>;
				sprd,qos-syscon = <0xae 0xbc 0xff 0xcf>;
				sprd,dpi-clk-parent = <0xaf>;
				/* AP DVFS work index 4: 384 MHz core clock, 0.75 V (kernel/patches/0002; /init until then) */
				sprd,dvfs-syscon = <0xc7 0x124 0x04>;
				phandle = <0x02>;

				port {
					phandle = <0x0f>;

					endpoint {
						remote-endpoint = <0xb0>;
						phandle = <0xb1>;
					};
				};
			};

			iommu@20300800 {
				compatible = "sprd,ums512-iommu", "sprd,iommu-v1";
				reg = <0x20300800 0x80>;
				sprd,iova-range = <0x90000000 0x10000000>;
				/* Shares DPU AHB gate (CLK_DISPC_EB) across CRTC off / suspend resume */
				clocks = <0x48 0x01>;
				#iommu-cells = <0x00>;
				status = "okay";
				phandle = <0xac>;
			};

			dsi@20400000 {
				compatible = "sprd,ums512-dsi-host", "sprd,ums9230-dsi-host";
				reg = <0x20400000 0x1000>;
				interrupts = <0x00 0x1e 0x04 0x00 0x1f 0x04>;
				clocks = <0x48 0x00>;
				clock-names = "pclk";
				sprd,phy-en-syscon = <0xae 0x40 0x03>;
				sprd,phy-pwr-syscon = <0x49 0x35c 0x08>;
				status = "okay";
				reset-syscon = <0xae 0x04 0x01>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				sprd,mipi-drive-capability = <0x05>;
				sprd,dpi-clk-div = <0x06>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0xb1>;
							phandle = <0xb0>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0xb2>;
							phandle = <0xb3>;
						};
					};
				};

				panel@0 {
					compatible = "rocknix,generic-dsi";
					reg = <0x00>;
					reset-gpios = <0x6c 0x32 0x00>;
					vdd-supply = <0x77>;
					iovcc-supply = <0x78>;
					panel_description =
						"G lanes=4 format=rgb888 size=136,225 flags=3 hs_rate=997000000 lp_rate=20000000 delays=1,5,5,60,20",
						"M clock=166159 horizontal=1200,40,12,16 vertical=1920,224,12,28 default=1",
						"I dcs=b9 data=83102e",
						"I dcs=e9 data=cd",
						"I dcs=bb data=01",
						"I dcs=e9 data=00",
						"I dcs=d1 data=670cff05",
						"I dcs=b1 data=10faafaf3131b16b313636363622211500",
						"I dcs=b2 data=00b047800026e0292000000015205700",
						"I dcs=b4 data=6a706a706a906a90019f015800ff00ff",
						"I dcs=d2 data=3131",
						"I dcs=bf data=fc85809c360004",
						"I dcs=d3 data=000000003ce80000003737330f2626040032102400243217a807a8321008000000002b50b6c82c4fb6c80f",
						"I dcs=e0 data=0007131c24425b616660757778837f8892a7a7535b66730007131c24425b616660757778837f8892a7a7535b6673",
						"I dcs=bd data=01",
						"I dcs=cb data=80361216c02854840234",
						"I dcs=d3 data=0100fc00001110000a0001",
						"I dcs=bd data=02",
						"I dcs=b4 data=4e0033113388",
						"I dcs=bf data=f20002",
						"I dcs=bd data=00",
						"I dcs=c0 data=33332211a2170080000008006363",
						"I dcs=d5 data=18181818181818181818191918181a1a1b1b0001020304050607202124251818181818181818181818181818",
						"I dcs=d6 data=18181818181818181818181819191a1a1b1b0706050403020100252421201818181818181818181818181818",
						"I dcs=d0 data=070405",
						"I dcs=e7 data=1213020255000e0e002629721c72012700000000170068",
						"I dcs=bd data=01",
						"I dcs=e7 data=013001940db50e",
						"I dcs=bd data=02",
						"I dcs=e7 data=ff01fd01000022000000000000000000000000000000000081000240",
						"I dcs=bd data=00",
						"I dcs=d8 data=aabbaaaaaaa0aabbaaaaaaa0",
						"I dcs=bd data=01",
						"I dcs=d8 data=fffffffffff0fffffffffff0",
						"I dcs=bd data=02",
						"I dcs=d8 data=fffc3ffffff0fffc3ffffff0",
						"I dcs=bd data=03",
						"I dcs=d8 data=002aaaaaaaa0002aaaaaaaa0002aaaaaaaa0002aaaaaaaa0",
						"I dcs=bd data=00",
						"I dcs=ba data=7003a885f280c00d",
						"I dcs=bd data=03",
						"I dcs=b2 data=80",
