			};

			opp-850000000 {
				opp-hz = <0x00 0x32a9f880>;
				opp-microvolt = "", "\f5";
			};
		};

		syscon@62200000 {
			compatible = "sprd,ums512-glbregs", "syscon", "simple-mfd";
