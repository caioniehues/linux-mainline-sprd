			};

			mmc@1200000 {
				compatible = "sprd,sdhci-r11";
				reg = <0x1200000 0x1000>;
				interrupts = <0x00 0x14 0x04>;
				clocks = <0x4a 0x14 0x6b 0x17>;
				clock-names = "sdio", "enable";
				assigned-clocks = <0x4a 0x14>;
				assigned-clock-parents = <0x45 0x17>;
				status = "okay";
				bus-width = <0x04>;
				sprd,phy-delay-sd-uhs-sdr104 = <0x7f 0x7a 0x72 0x72>;
				sprd,phy-delay-sd-uhs-sdr50 = <0x7f 0xf7 0xf5 0xf5>;
				sd-uhs-sdr104;
				sd-uhs-sdr50;
				no-sd;
				no-mmc;
				phandle = <0xb4>;
			};

			mmc@1400000 {
				compatible = "sprd,sdhci-r11";
				reg = <0x1400000 0x1000>;
				interrupts = <0x00 0x0a 0x04>;
				clocks = <0x4a 0x15 0x6b 0x19>;
				clock-names = "sdio", "enable";
				assigned-clocks = <0x4a 0x15>;
				assigned-clock-parents = <0x72 0x00>;
				status = "okay";
				vmmc-supply = <0x76>;
				bus-width = <0x08>;
				voltage-ranges = <0xbb8 0xbb8>;
				non-removable;
				cap-mmc-hw-reset;
				sprd,phy-delay-mmc-hs400es = <0x40 0x7f 0x2d 0x2d>;
				sprd,phy-delay-mmc-hs400 = <0x3f 0xdf 0x2f 0x2f>;
				sprd,phy-delay-mmc-hs200 = <0x7f 0xde 0xd4 0xd4>;
				sprd,phy-delay-mmc-ddr52 = <0x3e 0x37 0x24 0x24>;
				sprd,phy-delay-mmc-highspeed = <0x60 0xb7 0x34 0x34>;
				mmc-hs400-enhanced-strobe;
				mmc-hs400-1_8v;
				mmc-hs200-1_8v;
				mmc-ddr-1_8v;
				no-sdio;
				no-sd;
			};

			spi@a00000 {
				compatible = "sprd,sc9860-spi";
				reg = <0xa00000 0x1000>;
				interrupts = <0x00 0x07 0x04>;
				clock-names = "enable", "spi", "source";
				clocks = <0x6b 0x07 0x4a 0x0c 0x45 0x03>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";

				touchscreen@0 {
					compatible = "himax,hx83102e";
					reg = <0x00>;
					spi-max-frequency = <0x927c00>;
					spi-cpha;
					spi-cpol;
					/* The pad EXTINT0 carries the touch interrupt and LK leaves it on its
					 * function 0, the asynchronous EIC's line 0 (stock: himax,irq-gpio =
					 * <&eic_async 0>). GPIO 144 is the same pad's function 3 and sees
					 * nothing unless the pad is switched. */
					interrupt-parent = <0xc8>;
					interrupts = <0x00 0x02>;
					reset-gpios = <0x6c 0x91 0x01>;
					vsp-supply = <0x77>;
					vsn-supply = <0x78>;
					touchscreen-size-x = <0x4b0>;
					touchscreen-size-y = <0x780>;
					firmware-name = "himax/hx83102e_ls_hsd_firmware.bin";
				};
			};
		};

		bus@32000000 {
			compatible = "simple-bus";
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges = <0x00 0x00 0x32000000 0x1000000>;

			spi@100000 {
				compatible = "sprd,ums512-adi";
				reg = <0x100000 0x100000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				sprd,hw-channels = <0x02 0x18cc 0x03 0x18cc 0x0d 0x1854 0x0f 0x1874 0x11 0x1844 0x13 0x1844 0x15 0x1864 0x1e 0x1820 0x23 0x19b8 0x27 0x19ac>;

				pmic@0 {
					compatible = "sprd,sc2730";
					reg = <0x00>;
					spi-max-frequency = <0x18cba80>;
					interrupts = <0x00 0xad 0x04>;
					interrupt-controller;
					#interrupt-cells = <0x01>;
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					phandle = <0x79>;

					watchdog@40 {
						compatible = "sprd,sc2730-wdt", "sprd,sc27xx-wdt";
						reg = <0x40>;
					};

					led-controller@180 {
						compatible = "sprd,sc2730-bltc", "sprd,sc2731-bltc";
						reg = <0x180>;
						#address-cells = <0x01>;
						#size-cells = <0x00>;

						led@0 {
							label = "red";
							reg = <0x00>;
						};

						led@1 {
							label = "green";
							reg = <0x01>;
						};

						led@2 {
							label = "blue";
							reg = <0x02>;
						};
					};

					rtc@200 {
						compatible = "sprd,sc2730-rtc", "sprd,sc2731-rtc";
						reg = <0x200>;
						interrupt-parent = <0x79>;
						interrupts = <0x01>;
					};

					gpio@280 {
						compatible = "sprd,sc2730-eic", "sprd,sc2731-eic";
						reg = <0x280>;
						interrupt-parent = <0x79>;
						interrupts = <0x04>;
						gpio-controller;
						#gpio-cells = <0x02>;
						interrupt-controller;
						#interrupt-cells = <0x02>;
						phandle = <0x7c>;
					};

					efuse@300 {
						compatible = "sprd,sc2730-efuse";
						reg = <0x300>;
						#address-cells = <0x01>;
						#size-cells = <0x01>;
						hwlocks = <0x1c 0x0c>;

						pddelta-calib@2 {
							reg = <0x02 0x02>;
							bits = <0x07 0x07>;
							phandle = <0x81>;
						};

						fgu-calib@6 {
							reg = <0x06 0x02>;
							bits = <0x00 0x09>;
							phandle = <0x7e>;
						};

						pdrc-calib@7 {
							reg = <0x07 0x01>;
							bits = <0x01 0x07>;
							phandle = <0x80>;
						};

						typec-calib@1a {
							reg = <0x1a 0x02>;
							phandle = <0x83>;
						};

						pdref-calib@1f {
							reg = <0x1f 0x01>;
							bits = <0x04 0x04>;
							phandle = <0x82>;
						};

						adc-big-scale@24 {
							reg = <0x24 0x02>;
							phandle = <0x7a>;
						};

						adc-small-scale@26 {
							reg = <0x26 0x02>;
							phandle = <0x7b>;
						};

						aud-pabst-vcal@20 {
							reg = <0x20 0x02>;
							phandle = <0x84>;
						};

						neg-cp@22 {
							reg = <0x22 0x02>;
							phandle = <0x85>;
						};

						fgu-4p2@6 {
							reg = <0x06 0x02>;
							phandle = <0x86>;
						};

						codec-product-info@2e {
							reg = <0x2e 0x02>;
							phandle = <0x87>;
						};
					};

					adc@504 {
						compatible = "sprd,sc2730-adc";
						reg = <0x504>;
						interrupt-parent = <0x79>;
						interrupts = <0x00>;
						#io-channel-cells = <0x01>;
						hwlocks = <0x1c 0x04>;
						nvmem-cells = <0x7a 0x7b>;
						nvmem-cell-names = "big_scale_calib", "small_scale_calib";
						phandle = <0x7d>;
					};

					fuel-gauge@c00 {
						compatible = "sprd,sc2730-fgu";
						reg = <0xc00>;
						battery-detect-gpios = <0x7c 0x03 0x00>;
						io-channels = <0x7d 0x00 0x7d 0x0e>;
						io-channel-names = "bat-temp", "charge-vol";
						nvmem-cells = <0x7e>;
						nvmem-cell-names = "fgu_calib";
						interrupt-parent = <0x79>;
						interrupts = <0x03>;
						status = "okay";
						monitored-battery = <0x71>;
						power-supplies = <0x7f>;
						sprd,calib-resistance-micro-ohms = <0x2710>;
					};

					pd@e00 {
						compatible = "sprd,sc2730-pd";
						reg = <0xe00 0x380>;
						interrupt-parent = <0x79>;
						interrupts = <0x09 0x08>;
						nvmem-cells = <0x80 0x81 0x82 0x83 0x83>;
						nvmem-cell-names = "pdrc_calib", "pddelta_calib", "pdref_calib", "typec_cc1_cal", "typec_cc2_cal";
						status = "disabled";
					};

					audio-codec@1000 {
						compatible = "unisoc,sc2730-audio-codec", "sprd,sc2730-audio-codec";
						reg = <0x1000>;
						#sound-dai-cells = <0x01>;
						nvmem-cells = <0x84 0x85 0x86 0x87>;
						nvmem-cell-names = "aud_pabst_vcal_efuse", "neg_cp_efuse", "fgu_4p2_efuse", "codec_product_info";
						status = "okay";
						sprd,syscon-pmu-apb = <0x10>;
						hp-use-inter-pa = <0x01>;
						fixed-sample-rate = <0xbb80 0xbb80 0xbb80>;
						digital-codec = <0x88>;
						phandle = <0xbf>;
					};

					/*
					 * vibrator@1b90 intentionally omitted (Issue #14): SM-X200 has no
					 * vibration motor; PMIC LDO VDDVIB (0x1b90, 3.00 V) powers the
					 * display/touch panel. Never bind sc27xx-vibrator to it.
					 */

					regulators {

						dcdc-cpu {
							regulator-name = "vddcpu";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-gpu {
							regulator-name = "vddgpu";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
							phandle = <0x47>;
						};

						dcdc-core {
							regulator-name = "vddcore";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-modem {
							regulator-name = "vddmodem";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-mem {
							regulator-name = "vddmem";
							regulator-min-microvolt = <0x61a80>;
							regulator-max-microvolt = <0x185196>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-memq {
							regulator-name = "vddmemq";
							regulator-min-microvolt = <0x61a80>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-gen0 {
							regulator-name = "vddgen0";
							regulator-min-microvolt = <0x129da0>;
							regulator-max-microvolt = <0x24c881>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-gen1 {
							regulator-name = "vddgen1";
							regulator-min-microvolt = <0xcf850>;
							regulator-max-microvolt = <0x1914e6>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						dcdc-sram {
							regulator-name = "vddsram";
							regulator-min-microvolt = <0x30d40>;
							regulator-max-microvolt = <0x185dcb>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-avdd18 {
							regulator-name = "avdd18";
							regulator-min-microvolt = <0x11edd8>;
							regulator-max-microvolt = <0x1b8ac8>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-vddrf18 {
							regulator-name = "vddrf18";
							regulator-min-microvolt = <0x11edd8>;
							regulator-max-microvolt = <0x1b8ac8>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-vddcamio {
							regulator-name = "vddcamio";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x1bec70>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddwcn {
							regulator-name = "vddwcn";
							regulator-min-microvolt = <0xdbba0>;
							regulator-max-microvolt = <0x1c2708>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0xb5>;
						};

						ldo-vddcamd1 {
							regulator-name = "vddcamd1";
							regulator-min-microvolt = <0xdbba0>;
							regulator-max-microvolt = <0x14d408>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddcamd0 {
							regulator-name = "vddcamd0";
							regulator-min-microvolt = <0xdbba0>;
							regulator-max-microvolt = <0x14d408>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddrf1v25 {
							regulator-name = "vddrf1v25";
							regulator-min-microvolt = <0xdbba0>;
							regulator-max-microvolt = <0x14d408>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-avdd12 {
							regulator-name = "avdd12";
							regulator-min-microvolt = <0xdbba0>;
							regulator-max-microvolt = <0x14d408>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-vddcama0 {
							regulator-name = "vddcama0";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddcama1 {
							regulator-name = "vddcama1";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddcammot {
							regulator-name = "vddcammot";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddsim2 {
							regulator-name = "vddsim2";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0xb7>;
						};

						ldo-vddemmccore {
							regulator-name = "vddemmccore";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0x76>;
						};

						ldo-vddsdcore {
							regulator-name = "vddsdcore";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0x74>;
						};

						ldo-vddsdio {
							regulator-name = "vddsdio";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0x75>;
						};

						ldo-vdd28 {
							regulator-name = "vdd28";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-vddwifipa {
							regulator-name = "vddwifipa";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0xb6>;
						};

						ldo-vdd18-dcxo {
							regulator-name = "vdd18_dcxo";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							regulator-always-on;
						};

						ldo-vddusb33 {
							regulator-name = "vddusb33";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0x34>;
						};

						ldo-vddldo0 {
							regulator-name = "vddldo0";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddldo1 {
							regulator-name = "vddldo1";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddldo2 {
							regulator-name = "vddldo2";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
						};

						ldo-vddkpled {
							regulator-name = "vddkpled";
							regulator-min-microvolt = <0x124f80>;
							regulator-max-microvolt = <0x393870>;
							regulator-ramp-delay = <0x61a8>;
							phandle = <0xb8>;
						};
					};
				};
			};

			hwspinlock@7f0000 {
				compatible = "sprd,hwspinlock-r3p0";
				reg = <0x7f0000 0x10000>;
				#hwlock-cells = <0x01>;
				clocks = <0x1b 0x19>;
				clock-names = "enable";
				phandle = <0x1c>;
			};

			i2c@60000 {
				compatible = "sprd,sharkl5pro-hw-i2c";
				reg = <0x60000 0x1000>;
				interrupts = <0x00 0x44 0x04>;
				clock-names = "enable", "i2c", "source";
				clocks = <0x1b 0x24 0x89 0x11 0x1a>;
				clock-frequency = <0xf4240>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
			};

			gpio@70000 {
				compatible = "sprd,ums512-gpio", "sprd,sc9860-gpio";
				reg = <0x70000 0x10000>;
				gpio-controller;
				#gpio-cells = <0x02>;
				interrupt-controller;
				#interrupt-cells = <0x02>;
				interrupts = <0x00 0x3d 0x04>;
				phandle = <0x6c>;
			};

			pinctrl@450000 {
				compatible = "sprd,ums512-pinctrl";
				reg = <0x450000 0x3000>;

				vbc-iis3-0 {
					pins = "UMS512_IIS_INF0_SYS_SEL";
					sprd,control = <0x0e>;
					phandle = <0x37>;
				};

				vbc-iism0-0 {
					pins = "UMS512_IIS_INF0_SYS_SEL";
					sprd,control = <0x0f>;
					phandle = <0x38>;
				};

				vbc-iis-to-pad {
					pins = "UMS512_VBC_IIS_INF_SYS_SEL";
					sprd,control = <0x00>;
					phandle = <0x39>;
				};

				vbc-iis-to-aon-usb {
					pins = "UMS512_VBC_IIS_INF_SYS_SEL";
					sprd,control = <0x01>;
					phandle = <0x3a>;
				};

				vbc-iism0-1 {
					pins = "UMS512_IIS_INF1_SYS_SEL";
					sprd,control = <0x0f>;
					phandle = <0x3b>;
				};

				vbc-iism0-3 {
					pins = "UMS512_IIS_INF3_SYS_SEL";
					sprd,control = <0x0f>;
					phandle = <0x3c>;
				};

				vbc-iis0-3 {
					pins = "UMS512_IIS_INF3_SYS_SEL";
					sprd,control = <0x0b>;
					phandle = <0x3d>;
				};

				vbc-iis1-3 {
					pins = "UMS512_IIS_INF3_SYS_SEL";
					sprd,control = <0x0c>;
					phandle = <0x3e>;
				};

				vbc-iis2-3 {
					pins = "UMS512_IIS_INF3_SYS_SEL";
					sprd,control = <0x0d>;
					phandle = <0x3f>;
				};

				vbc-iis3-3 {
					pins = "UMS512_IIS_INF3_SYS_SEL";
					sprd,control = <0x0e>;
					phandle = <0x40>;
				};

				ap-iis0-3 {
					pins = "UMS512_IIS_INF3_SYS_SEL";
					sprd,control = <0x00>;
					phandle = <0x41>;
				};

				i2c4-pin-func {
					pins = "UMS512_SIMCLK2", "UMS512_SIMDA2";
					function = "func2";
					phandle = <0x6d>;
				};

				i2c4-pin-misc {
					pins = "UMS512_SIMCLK2_MISC", "UMS512_SIMDA2_MISC";
					bias-pull-up = <0x125c>;
					phandle = <0x6e>;
				};

				charger-int-func {
					pins = "UMS512_MTCK_ARM";
					function = "func4";
					phandle = <0x6f>;
				};

				charger-int-misc {
					pins = "UMS512_MTCK_ARM_MISC";
					input-enable;
					bias-pull-up = <0x4e20>;
					phandle = <0x70>;
				};
			};

			pwm@260000 {
				compatible = "sprd,ums512-pwm";
				reg = <0x260000 0x10000>;
				clocks = <0x89 0x06 0x1b 0x32 0x89 0x07 0x1b 0x33 0x89 0x08 0x1b 0x34 0x89 0x09 0x1b 0x35>;
				clock-names = "pwm0", "enable0", "pwm1", "enable1", "pwm2", "enable2", "pwm3", "enable3";
				assigned-clocks = <0x89 0x06 0x89 0x07 0x89 0x08 0x89 0x09>;
				assigned-clock-parents = <0x1a 0x1a 0x1a 0x1a>;
				#pwm-cells = <0x02>;
			};

			thermal@200000 {
				compatible = "sprd,ums512-thermal";
				reg = <0x200000 0x10000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clock-names = "enable";
				clocks = <0x1b 0x20>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x8a 0x8b>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0x9d>;

				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x8c>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x8d>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@2 {
					reg = <0x02>;
					nvmem-cells = <0x8e>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@3 {
					reg = <0x03>;
					nvmem-cells = <0x8f>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@4 {
					reg = <0x04>;
					nvmem-cells = <0x90>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			thermal@210000 {
				compatible = "sprd,ums512-thermal";
				reg = <0x210000 0x10000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clock-names = "enable";
				clocks = <0x1b 0x21>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x91 0x92>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0xa1>;

				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x93>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@1 {
					reg = <0x01>;
					nvmem-cells = <0x94>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@2 {
					reg = <0x02>;
					nvmem-cells = <0x95>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@3 {
					reg = <0x03>;
					nvmem-cells = <0x96>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@4 {
					reg = <0x04>;
					nvmem-cells = <0x97>;
					nvmem-cell-names = "sen_delta_cal";
				};

				sensor@5 {
					reg = <0x05>;
					nvmem-cells = <0x98>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			thermal@220000 {
				compatible = "sprd,ums512-thermal";
				reg = <0x220000 0x10000>;
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				clock-names = "enable";
				clocks = <0x1b 0x22>;
				#thermal-sensor-cells = <0x01>;
				nvmem-cells = <0x99 0x9a>;
				nvmem-cell-names = "thm_sign_cal", "thm_ratio_cal";
				phandle = <0xa7>;

				sensor@0 {
					reg = <0x00>;
					nvmem-cells = <0x9b>;
					nvmem-cell-names = "sen_delta_cal";
				};
			};

			watchdog@2f0000 {
				compatible = "sprd,ums512-wdt", "sprd,sp9860-wdt";
				reg = <0x2f0000 0x10000>;
				interrupts = <0x00 0x4f 0x04>;
				timeout-sec = <0x1e>;
				clock-names = "enable", "rtc_enable";
				clocks = <0x1b 0x37 0x1b 0x41>;
			};
		};

		usb@5fff0000 {
			compatible = "sprd,ums512-musb", "sprd,musb";
			reg = <0x00 0x5fff0000 0x00 0x2000>;
			interrupts = <0x00 0x45 0x04>;
			interrupt-names = "mc";
			clocks = <0x1b 0x17>;
			phys = <0x9c>;
			status = "okay";
			dr_mode = "peripheral";
		};

